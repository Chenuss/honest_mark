# SMTP настройки для отправки email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=your_password
SMTP_FROM=noreply@honest-mark.local

# Список email-адресов руководства (через запятую)
MANAGEMENT_EMAILS=boss@example.com,manager@example.com,director@example.com

# База данных
DATABASE_URL=mysql+pymysql://user:password@localhost/dbname

# JWT секрет
SECRET_KEY=your-secret-key-here

# ── ТП ЧЗ: работа с техподдержкой ЦРПТ ──
CRPT_SUPPORT_EMAIL=support@crpt.ru
MARKIROVKA_EMAIL=markirovka@belor.ru
CRPT_SMTP_HOST=smtp.belor.ru
CRPT_SMTP_PORT=465
CRPT_SMTP_USER=markirovka@belor.ru
CRPT_SMTP_PASSWORD=your_password
CRPT_IMAP_HOST=imap.belor.ru
CRPT_IMAP_PORT=993
CRPT_IMAP_USER=markirovka@belor.ru
CRPT_IMAP_PASSWORD=your_password
CRPT_EMAIL_PARSE_INTERVAL_MIN=5
CRPT_SCHEDULER_ENABLED=true
ENTERPRISE_NAME=ООО "Белоречье"
ENTERPRISE_INN=2330012345
